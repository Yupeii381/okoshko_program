<Window x:Class="okoshko.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:okoshko"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="300">
    <Grid>
        <Button Content="Выбрать файл" HorizontalAlignment="Center" VerticalAlignment="Top" Width="100" Margin="30" Click="Choose_File"/>
        <RadioButton x:Name="Decode_RB" Content="Decode" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="60" Checked="Decode_RB_Checked"/>
        <RadioButton x:Name="Encode_RB"  Content="Encode" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="80" Checked="Encode_RB_Checked" />
        <Button Content="Действовать" HorizontalAlignment="Center" VerticalAlignment="Top" Width="100" Margin="0,123,0,0" Click="DoAnAction"/>
        <TextBlock x:Name="Output" HorizontalAlignment="Center" VerticalAlignment="Top" Width="10" Margin="130"/> 
    </Grid>
</Window>
